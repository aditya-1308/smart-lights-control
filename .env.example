# ==============================================================================
#                      RoomLights - Configuration File (.env)
# ==============================================================================
# Instructions:
#   1. Copy this entire file and rename the copy to ".env" (without quotes)
#   2. Fill in your hardware IP addresses and keys below
#   3. Lines starting with '#' are helpful comments and are ignored by the app
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. WLED ESP Board Configuration
# ------------------------------------------------------------------------------
# Local IP address of your WLED board on your Wi-Fi network.
WLED_IP=192.168.1.100


# ------------------------------------------------------------------------------
# 2. WLED Hardware Segment Role Mapping
# ------------------------------------------------------------------------------
# Physical layout (total 150 LEDs):
#   Seg 1 (LEDs 0-17)    : Left half of bottom indicator bar
#   Seg 0 (LEDs 17-126)  : Screen ambient perimeter (Main Segment for UDP)
#   Seg 2 (LEDs 126-144) : Right half of bottom indicator bar
#   Seg 3 (LEDs 144-150) : Pomodoro wall strip (-1 to disable)
SEGMENT_SCREEN_CAPTURE=0
SEGMENT_LIGHTBAR_LEFT=1
SEGMENT_LIGHTBAR_RIGHT=2
SEGMENT_POMODORO=3


# ------------------------------------------------------------------------------
# 3. Screen Ambient Capture (Seg 0 Realtime UDP)
# ------------------------------------------------------------------------------
# Uses high-speed DXcam / Desktop Duplication and your Prismatik profile calibration.
SCREEN_CAPTURE_FPS=30
SCREEN_CAPTURE_GAMMA=1.8
SCREEN_CAPTURE_SATURATION=1.3
SCREEN_CAPTURE_SWAP_RGB=false


# ------------------------------------------------------------------------------
# 4. Sim Racing Telemetry Settings (100% Pure UDP - Zero Game Crashes)
# ------------------------------------------------------------------------------
# All sim games are auto-detected on the fly via UDP network ports:
#   AC_UDP_PORT    : Assetto Corsa native UDP port (default 9996)
#   F1_UDP_PORT    : F1 23 / 24 UDP port (default 20777)
#   AMS2_UDP_PORT  : Automobilista 2 / PCARS2 UDP port (default 5606)
#   FORZA_UDP_PORT : Forza Motorsport / Horizon Data Out UDP port (default 5300)
AC_UDP_PORT=9996
F1_UDP_PORT=20777
AMS2_UDP_PORT=5606
FORZA_UDP_PORT=5300


# ------------------------------------------------------------------------------
# 5. Counter-Strike 2 (CS2) Integration
# ------------------------------------------------------------------------------
# Port for CS2 Game State Integration HTTP server.
CS2_GSI_PORT=3000
CS2_GSI_TOKEN=roomlights_secret_token_123


# ------------------------------------------------------------------------------
# 6. Tuya Ambient Ceiling Light Configuration
# ------------------------------------------------------------------------------
# Run 'python -m tinytuya wizard' to extract your local key automatically.
TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_16char_key_here
TUYA_IP=192.168.1.101
TUYA_VERSION=3.3


# ------------------------------------------------------------------------------
# 7. Pomodoro Timer
# ------------------------------------------------------------------------------
# Duration in minutes for the Pomodoro focus timer on Seg 3 (wall strip).
POMODORO_DURATION_MIN=25


# ------------------------------------------------------------------------------
# 8. Hotkeys / Keybinds (Customizable Shortcuts)
# ------------------------------------------------------------------------------
KEYBIND_TUYA_TOGGLE=<ctrl>+<shift>+l
KEYBIND_TUYA_BRIGHTNESS_UP=<ctrl>+<shift>+<up>
KEYBIND_TUYA_BRIGHTNESS_DOWN=<ctrl>+<shift>+<down>
