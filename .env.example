# ============================================================
# RoomLights Configuration
# Copy this file to .env and fill in your actual values.
# ============================================================

# === WLED ESP Board ===
WLED_IP=192.168.1.100

# === Tuya Ceiling Light ===
# Get these via: python -m tinytuya wizard
TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_16char_key_here
TUYA_IP=192.168.1.101
TUYA_VERSION=3.3

# === CS2 Game State Integration ===
CS2_GSI_PORT=3000
CS2_GSI_TOKEN=roomlights_secret_token_123

# === Sim Racing (fallback when DS4 lightbar unavailable) ===
# Options: AC (Assetto Corsa shared memory) | F1 (F1 23/24 UDP)
SIM_GAME=AC
F1_UDP_PORT=20777

# === Pomodoro Timer ===
POMODORO_DURATION_MIN=25

# === Screen Capture (Seg 0 ambient) ===
# FPS for screen edge capture. Default 24, max 60.
SCREEN_CAPTURE_FPS=24
