# ==============================================================================
#                      RoomLights - Configuration File (.env)
# ==============================================================================
# Instructions:
#   1. Copy this entire file and rename the copy to ".env" (without quotes)
#   2. Fill in your hardware IP addresses and keys below
#   3. Lines starting with '#' are helpful comments and are ignored by the app
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. WLED ESP Board Configuration
# ------------------------------------------------------------------------------
# The local IP address of your WLED board on your Wi-Fi network.
# You can find this in your router settings or the WLED mobile app.
WLED_IP=192.168.1.100


# ------------------------------------------------------------------------------
# 2. Tuya Ambient Ceiling Light Configuration
# ------------------------------------------------------------------------------
# To get your device_id and local_key automatically:
#   1. Open a terminal in this folder
#   2. Run: python -m tinytuya wizard
#   3. Follow the onscreen prompts to log into your Tuya developer account
#
# TUYA_DEVICE_ID : 20-character device ID for your ceiling bulb
# TUYA_LOCAL_KEY : 16-character local encryption key
# TUYA_IP        : Local IP address of the bulb on your Wi-Fi network
# TUYA_VERSION   : Protocol version (usually 3.3 for Homemate/Tuya bulbs)
TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_16char_key_here
TUYA_IP=192.168.1.101
TUYA_VERSION=3.3


# ------------------------------------------------------------------------------
# 3. Sim Racing Telemetry Settings (Auto-Detected)
# ------------------------------------------------------------------------------
# Assetto Corsa and F1 23/24 are auto-detected on the fly. No toggle needed!
# F1_UDP_PORT : UDP port configured in F1 23/24 Telemetry settings (default 20777)
F1_UDP_PORT=20777



# ------------------------------------------------------------------------------
# 4. Counter-Strike 2 (CS2) Integration
# ------------------------------------------------------------------------------
# Port for CS2 Game State Integration HTTP server.
# Make sure gamestate_integration_roomlights.cfg in your CS2 cfg folder matches this!
CS2_GSI_PORT=3000
CS2_GSI_TOKEN=roomlights_secret_token_123


# ------------------------------------------------------------------------------
# 5. Screen Capture (Seg 0 Ambient Lighting)
# ------------------------------------------------------------------------------
# Target refresh rate for desktop screen capture on Seg 0 (109 LEDs).
# Recommended: 24 for movies/desktop, 30 or 60 for gaming.
SCREEN_CAPTURE_FPS=24


# ------------------------------------------------------------------------------
# 6. Pomodoro Timer
# ------------------------------------------------------------------------------
# Duration in minutes for the Pomodoro focus timer on Seg 3 (wall strip).
POMODORO_DURATION_MIN=25


# ------------------------------------------------------------------------------
# 7. Hotkeys / Keybinds (Customizable Shortcuts)
# ------------------------------------------------------------------------------
# Customize your keyboard shortcuts using pynput format:
#   <ctrl>+<shift>+l       : Toggle Tuya room ambient control ON / OFF
#   <ctrl>+<shift>+<up>    : Increase Tuya ceiling brightness by 1% (instant)
#   <ctrl>+<shift>+<down>  : Decrease Tuya ceiling brightness by 1% (instant)
#
# Examples of key names you can use:
#   <ctrl>, <shift>, <alt>, <up>, <down>, <left>, <right>, a-z, 0-9, <f1>-<f12>
KEYBIND_TUYA_TOGGLE=<ctrl>+<shift>+l
KEYBIND_TUYA_BRIGHTNESS_UP=<ctrl>+<shift>+<up>
KEYBIND_TUYA_BRIGHTNESS_DOWN=<ctrl>+<shift>+<down>


# ------------------------------------------------------------------------------
# 8. WLED Segment Role Mapping (Auto-Discovered from WLED Board)
# ------------------------------------------------------------------------------
# Assign your WLED segment IDs to roles. Set any setting to -1 to disable it.
#
# Dual-segment lightbar (like right half Seg 1 + left half Seg 2):
SEGMENT_SCREEN_CAPTURE=0
SEGMENT_LIGHTBAR_RIGHT=1
SEGMENT_LIGHTBAR_LEFT=2
SEGMENT_POMODORO=3

# Single-segment lightbar alternative:
# If you have ONE continuous strip for your lightbar (e.g. Seg 1), uncomment below:
# SEGMENT_LIGHTBAR=1


