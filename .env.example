# ==============================================================================
#                      RoomLights - Configuration File (.env)
# ==============================================================================
# Instructions:
#   1. Copy this entire file and rename the copy to ".env" (without quotes)
#   2. Fill in your hardware IP addresses and keys below
#   3. Lines starting with '#' are helpful comments and are ignored by the app
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. WLED ESP Board Configuration
# ------------------------------------------------------------------------------
# Local IP address of your WLED board on your Wi-Fi network.
WLED_IP=192.168.1.100


# ------------------------------------------------------------------------------
# 2. WLED Hardware Segment Role Mapping
# ------------------------------------------------------------------------------
# Map your WLED segment IDs to RoomLights roles:
SEGMENT_SCREEN_CAPTURE=0
SEGMENT_LIGHTBAR_LEFT=1
SEGMENT_LIGHTBAR_RIGHT=2
SEGMENT_LIGHTBAR=-1
SEGMENT_POMODORO=3

# Optional: Invert segment LED direction (true/false)
INVERT_SCREEN_CAPTURE=false
INVERT_LIGHTBAR_LEFT=false
INVERT_LIGHTBAR_RIGHT=false
INVERT_LIGHTBAR=false
INVERT_POMODORO=false


# ------------------------------------------------------------------------------
# 3. Screen Ambient Capture & Calibration Profile
# ------------------------------------------------------------------------------
# Target capture framerate (default 60 FPS)
SCREEN_CAPTURE_FPS=60

# Prismatik profile name located inside the profiles/ folder
PRISMATIK_PROFILE=Movies.ini


# ------------------------------------------------------------------------------
# 4. Sim Racing Telemetry Settings (100% Pure UDP & Shared Memory)
# ------------------------------------------------------------------------------
# All sim games are auto-detected on the fly:
#   AC             : Assetto Corsa native Windows Shared Memory (zero setup)
#   F1_UDP_PORT    : F1 23 / 24 / 25 UDP port (default 20777)
#   AMS2_UDP_PORT  : Automobilista 2 / PCARS2 UDP port (default 5606)
#   FORZA_UDP_PORT : Forza Motorsport / Horizon Data Out UDP port (default 5300)
AC_UDP_PORT=9996
F1_UDP_PORT=20777
AMS2_UDP_PORT=5606
FORZA_UDP_PORT=5300


# ------------------------------------------------------------------------------
# 5. Counter-Strike 2 (CS2) Integration
# ------------------------------------------------------------------------------
# Port for CS2 Game State Integration HTTP server.
CS2_GSI_PORT=3000
CS2_GSI_TOKEN=roomlights_secret_token_123


# ------------------------------------------------------------------------------
# 6. PlayStation DualSense / DS4 Lightbar Controller Emulation
# ------------------------------------------------------------------------------
# Emulate a virtual PlayStation controller via ViGEmBus:
#   auto  : Dynamically attaches when ANY game starts, detaches when game closes (Default)
#   true  : Keep virtual controller permanently connected
#   false : Disable virtual controller emulation
ENABLE_VIRTUAL_DS4=auto


# ------------------------------------------------------------------------------
# 7. Tuya Ambient Ceiling Light Configuration
# ------------------------------------------------------------------------------
# Run 'python -m tinytuya wizard' to extract your local key automatically.
TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_16char_key_here
TUYA_IP=192.168.1.101
TUYA_VERSION=3.3


# ------------------------------------------------------------------------------
# 7. Pomodoro Timer
# ------------------------------------------------------------------------------
# Duration in minutes for the Pomodoro focus timer on Seg 3 (wall strip).
POMODORO_DURATION_MIN=25


# ------------------------------------------------------------------------------
# 8. Hotkeys / Keybinds (Customizable Shortcuts)
# ------------------------------------------------------------------------------
KEYBIND_TUYA_TOGGLE=<ctrl>+<shift>+l
KEYBIND_TUYA_BRIGHTNESS_UP=<ctrl>+<shift>+<up>
KEYBIND_TUYA_BRIGHTNESS_DOWN=<ctrl>+<shift>+<down>
